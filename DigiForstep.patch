+void CPH_GenericInput::SetRemoteState(unsigned int pad, bool active, uint32 buttons, const uint8* axes)
+{
+	if(pad >= CInputBindingManager::MAX_PADS) return;
+	std::lock_guard<std::mutex> lock(m_remoteMutex);
+	auto& remote = m_remote[pad];
+	remote.active = active;
+	remote.buttons = active ? buttons : 0;
+	for(int i = 0; i < 4; i++)
+	{
+		remote.axes[i] = (active && axes) ? axes[i] : 0x80;
+	}
+}
+
+void CPH_GenericInput::GetLocalState(unsigned int pad, uint32& buttons, uint8* axes)
+{
+	buttons = 0;
+	for(int i = 0; i < 4; i++) axes[i] = 0x80;
+	for(unsigned int buttonIdx = 0; buttonIdx < PS2::CControllerInfo::MAX_BUTTONS; buttonIdx++)
+	{
+		auto button = static_cast<PS2::CControllerInfo::BUTTON>(buttonIdx);
+		const auto& binding = m_bindingManager.GetBinding(pad, button);
+		if(!binding) continue;
+		uint32 value = binding->GetValue();
+		if(PS2::CControllerInfo::IsAxis(button))
+		{
+			axes[buttonIdx] = static_cast<uint8>(value & 0xFF);
+		}
+		else if(value != 0)
+		{
+			buttons |= (1U << buttonIdx);
+		}
+	}
+}
