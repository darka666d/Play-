@@ -0,0 +1,87 @@
+#pragma once
+
+#include <exception>
+#include <functional>
+#include <memory>
+#include <mutex>
+#include <vector>
+#include "sound/SoundHandler.h"
+
+// Receives a copy of every audio block the emulator plays, while the online host has guests.
+class CAudioShare
+{
+public:
+	using Handler = std::function<void(const int16*, unsigned int, unsigned int)>;
+
+	static CAudioShare& GetInstance()
+	{
+		static CAudioShare instance;
+		return instance;
+	}
+
+	void Enable(Handler handler)
+	{
+		std::lock_guard<std::mutex> lock(m_mutex);
+		m_handler = std::move(handler);
+	}
+
+	void Disable()
+	{
+		std::lock_guard<std::mutex> lock(m_mutex);
+		m_handler = nullptr;
+	}
+
+	void Submit(const int16* samples, unsigned int count, unsigned int rate)
+	{
+		std::lock_guard<std::mutex> lock(m_mutex);
+		if(m_handler) m_handler(samples, count, rate);
+	}
+
+private:
+	std::mutex m_mutex;
+	Handler m_handler;
+};
+
+// Wraps the real sound handler: plays normally and also feeds CAudioShare.
+class CSH_AudioTap : public CSoundHandler
+{
+public:
+	CSH_AudioTap(std::unique_ptr<CSoundHandler> inner)
+	    : m_inner(std::move(inner))
+	{
+	}
+
+	static FactoryFunction Wrap(FactoryFunction innerFactory)
+	{
+		return [innerFactory]() -> CSoundHandler* {
+			//No audio device (e.g. a VPS): keep going with a silent sink so guests still get the audio.
+			std::unique_ptr<CSoundHandler> inner;
+			try
+			{
+				inner.reset(innerFactory());
+			}
+			catch(const std::exception&)
+			{
+			}
+			return new CSH_AudioTap(std::move(inner));
+		};
+	}
+
+	void Reset() override
+	{
+		if(m_inner) m_inner->Reset();
+	}
+	bool HasFreeBuffers() override { return m_inner ? m_inner->HasFreeBuffers() : true; }
+	void RecycleBuffers() override
+	{
+		if(m_inner) m_inner->RecycleBuffers();
+	}
+	void Write(int16* samples, unsigned int count, unsigned int rate) override
+	{
+		CAudioShare::GetInstance().Submit(samples, count, rate);
+		if(m_inner) m_inner->Write(samples, count, rate);
+	}
+
+private:
+	std::unique_ptr<CSoundHandler> m_inner;
+};
