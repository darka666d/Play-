+	void SetQualityPreset(int preset); // 0 = low latency, 1 = balanced, 2 = high quality
+
+signals:
+	void guestsChanged();
+
+private slots:
+	void OnNewConnection();
+
+private:
+	struct Guest
+	{
+		QTcpSocket* socket = nullptr;
+		QByteArray rx;
+		quint32 buttons = 0;
+		quint8 axes[4] = {0x80, 0x80, 0x80, 0x80};
+		int pad = 0;
+		quint16 lastSeq = 0;
+		bool hasSeq = false;
+	};
