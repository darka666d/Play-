+//////////////////////////////////////////////////////////////////////////////////////////
+// Guest window
+//////////////////////////////////////////////////////////////////////////////////////////
+
+COnlineGuestWindow::COnlineGuestWindow(const QString& host, quint16 port, PadHandlerGetter getter, std::shared_ptr<CInputProviderQtKey> keyProvider, QWidget* parent)
+    : QWidget(parent, Qt::Window)
+    , m_padHandlerGetter(std::move(getter))
+    , m_keyProvider(std::move(keyProvider))
+    , m_host(host)
+{
+	setAttribute(Qt::WA_DeleteOnClose);
+	setFocusPolicy(Qt::StrongFocus);
+	resize(640, 480);
+	setWindowTitle(tr("DigiForstep - Guest"));
+	m_port = port;
+	m_status = tr("Connecting to %1:%2 ...").arg(host).arg(port);
+
+	connect(&m_socket, &QTcpSocket::readyRead, this, &COnlineGuestWindow::OnReadyRead);
+	connect(&m_socket, &QTcpSocket::disconnected, this, &COnlineGuestWindow::OnDisconnected);
+	auto onError = [this](QAbstractSocket::SocketError) {
+		m_status = tr("Connection failed: %1").arg(m_socket.errorString());
+		update();
+	};
+#if QT_VERSION >= QT_VERSION_CHECK(5, 15, 0)
+	connect(&m_socket, &QAbstractSocket::errorOccurred, this, onError);
+#else
+	connect(&m_socket, QOverload<QAbstractSocket::SocketError>::of(&QAbstractSocket::error), this, onError);
+#endif
+	connect(&m_inputTimer, &QTimer::timeout, this, &COnlineGuestWindow::SendInput);
+
+	try
+	{
+#ifdef _WIN32
+		m_sound.reset(CSH_WaveOut::HandlerFactory());
+#else
+		m_sound.reset(CSH_OpenAL::HandlerFactory());
+#endif
+	}
+	catch(const std::exception&)
+	{
+		m_sound.reset(); //no audio device: video/input still work
+	}
+
+	m_socket.setSocketOption(QAbstractSocket::LowDelayOption, 1);
+	m_socket.connectToHost(host, port);
+	m_inputTimer.start(8);
+}
+
+void COnlineGuestWindow::OnReadyRead()
+{
+	m_rx.append(m_socket.readAll());
+	bool ok = Unpack(m_rx, [this](quint8 type, const QByteArray& payload) {
+		if(type == MSG_WELCOME && payload.size() >= 2)
+		{
+			if(static_cast<quint8>(payload[0]) == 0xFF)
+			{
+				m_status = tr("The session is full (4 players max).");
+				return;
+			}
+			m_welcomed = true;
+			m_slot = static_cast<quint8>(payload[0]);
+			m_lastButtons = 0xFFFFFFFF; // force an input send
+			setWindowTitle(tr("DigiForstep - Guest %1 (controlling pad %2) - %3")
+			                   .arg(static_cast<quint8>(payload[0]) + 1)
+			                   .arg(static_cast<quint8>(payload[1]) + 1)
+			                   .arg(m_host));
+			m_status = tr("Connected. Waiting for the host to start a game...");
+		}
+		else if(type == MSG_AUDIO && m_sound && payload.size() > 4)
+		{
+			quint32 rate = qFromLittleEndian<quint32>(payload.constData());
+			unsigned int count = (payload.size() - 4) / sizeof(int16);
+			m_sound->RecycleBuffers();
+			if(m_sound->HasFreeBuffers()) //otherwise drop, keeps latency bounded
+			{
+				QByteArray copy = payload.mid(4); //Write() needs a mutable, aligned buffer
+				m_sound->Write(reinterpret_cast<int16*>(copy.data()), count, rate);
+			}
+		}
+		else if(type == MSG_FRAME)
+		{
+			QImage image = QImage::fromData(payload, "JPEG");
+			if(!image.isNull())
+			{
+				m_frame = std::move(image);
+				update();
+			}
+		}
+	});
+	if(!ok) m_socket.abort();
+}
+
+void COnlineGuestWindow::OnDisconnected()
+{
+	m_welcomed = false;
+	m_status = tr("Disconnected from the host.");
+	update();
+}
+
+void COnlineGuestWindow::SendInput()
+{
+	if(!m_welcomed || m_socket.state() != QAbstractSocket::ConnectedState) return;
+	auto* padHandler = m_padHandlerGetter ? m_padHandlerGetter() : nullptr;
+	if(!padHandler) return;
+
+	quint32 buttons = 0;
+	uint8 axes[4] = {};
+	padHandler->GetLocalState(0, buttons, axes);
+	bool changed = !(buttons == m_lastButtons && memcmp(axes, m_lastAxes, 4) == 0);
+	if(!changed && m_sendTimer.isValid() && m_sendTimer.elapsed() < 25) return; // resend state every 25ms (UDP can drop)
+	m_lastButtons = buttons;
+	memcpy(m_lastAxes, axes, 4);
+	m_sendTimer.restart();
+
+	QByteArray datagram(11, 0);
+	datagram[0] = static_cast<char>(m_slot);
+	qToLittleEndian<quint16>(++m_seq, datagram.data() + 1);
+	qToLittleEndian<quint32>(buttons, datagram.data() + 3);
+	memcpy(datagram.data() + 7, axes, 4);
+	m_udp.writeDatagram(datagram, m_socket.peerAddress(), m_port);
+}
+
+void COnlineGuestWindow::paintEvent(QPaintEvent*)
+{
+	QPainter painter(this);
+	painter.fillRect(rect(), Qt::black);
+	if(!m_frame.isNull() && m_welcomed)
+	{
+		QSize size = m_frame.size().scaled(this->size(), Qt::KeepAspectRatio);
+		QRect target(QPoint((width() - size.width()) / 2, (height() - size.height()) / 2), size);
+		painter.setRenderHint(QPainter::SmoothPixmapTransform);
+		painter.drawImage(target, m_frame);
+	}
+	else
+	{
+		painter.setPen(Qt::white);
+		painter.drawText(rect(), Qt::AlignCenter | Qt::TextWordWrap, m_status);
+	}
+}
+
+void COnlineGuestWindow::keyPressEvent(QKeyEvent* event)
+{
+	if(event->key() == Qt::Key_F11 || (event->key() == Qt::Key_Escape && isFullScreen()))
+	{
+		isFullScreen() ? showNormal() : showFullScreen();
+		return;
+	}
+	if(!event->isAutoRepeat() && m_keyProvider) m_keyProvider->OnKeyPress(event->key());
+}
+
+void COnlineGuestWindow::keyReleaseEvent(QKeyEvent* event)
+{
+	if(!event->isAutoRepeat() && m_keyProvider) m_keyProvider->OnKeyRelease(event->key());
+}
