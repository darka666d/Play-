+void MainWindow::JoinOnlineSession()
+{
+	bool ok = false;
+	auto text = QInputDialog::getText(this, tr("Join Session"), tr("Host address (IP or IP:port):"), QLineEdit::Normal, m_lastJoinAddress, &ok).trimmed();
+	if(!ok || text.isEmpty()) return;
+	m_lastJoinAddress = text;
+
+	QString host = text;
+	quint16 port = OnlineProto::DEFAULT_PORT;
+	int colon = text.lastIndexOf(':');
+	if(colon > 0)
+	{
+		host = text.left(colon);
+		port = static_cast<quint16>(text.mid(colon + 1).toUInt());
+	}
+
+	PadHandlerGetter padHandlerGetter = [this]() -> CPH_GenericInput* {
+		return m_virtualMachine ? static_cast<CPH_GenericInput*>(m_virtualMachine->GetPadHandler()) : nullptr;
+	};
+	auto* window = new COnlineGuestWindow(host, port, padHandlerGetter, m_qtKeyInputProvider, this);
+	window->show();
+}
