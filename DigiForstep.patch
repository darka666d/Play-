diff --git a/Source/ui_qt/FrameShare.h b/Source/ui_qt/FrameShare.h
new file mode 100644
index 0000000..79f4319
--- /dev/null
+++ b/Source/ui_qt/FrameShare.h
@@ -0,0 +1,61 @@
+#pragma once
+
+#include <QImage>
+#include <atomic>
+#include <chrono>
+#include <functional>
+#include <mutex>
+
+// Bridge between the GS thread (which owns the OpenGL back buffer) and the online host.
+// The GS thread asks ShouldCapture() once per presented frame and, if true, reads back the
+// back buffer and calls Submit(). Capture is off unless a guest is connected.
+class CFrameShare
+{
+public:
+	using Handler = std::function<void(QImage)>;
+
+	static CFrameShare& GetInstance()
+	{
+		static CFrameShare instance;
+		return instance;
+	}
+
+	void Enable(Handler handler)
+	{
+		std::lock_guard<std::mutex> lock(m_mutex);
+		m_handler = std::move(handler);
+		m_enabled = true;
+	}
+
+	void Disable()
+	{
+		m_enabled = false;
+		std::lock_guard<std::mutex> lock(m_mutex);
+		m_handler = nullptr;
+	}
+
+	void SetIntervalMs(int ms) { m_intervalMs = ms; }
+
+	// Called from the GS thread only.
+	bool ShouldCapture()
+	{
+		if(!m_enabled) return false;
+		auto now = std::chrono::steady_clock::now();
+		if(now - m_lastCapture < std::chrono::milliseconds(m_intervalMs.load())) return false;
+		m_lastCapture = now;
+		return true;
+	}
+
+	void Submit(QImage image)
+	{
+		std::lock_guard<std::mutex> lock(m_mutex);
+		if(m_handler) m_handler(std::move(image));
+	}
+
+private:
+	std::atomic<bool> m_enabled{false};
+	std::atomic<int> m_intervalMs{33};
+	std::mutex m_mutex;
+	Handler m_handler;
+	std::chrono::steady_clock::time_point m_lastCapture;
+};
