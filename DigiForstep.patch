+	QUdpSocket m_udp;
+	std::atomic<int> m_jpegQuality{45};
+	std::atomic<int> m_maxWidth{448};
+	Guest m_guests[OnlineProto::MAX_GUESTS];
+	PadHandlerGetter m_padHandlerGetter;
+
+	std::thread m_encoderThread;
+	std::mutex m_encoderMutex;
+	std::condition_variable m_encoderCv;
+	QImage m_pendingImage;
+	bool m_encoderQuit = false;
+};
