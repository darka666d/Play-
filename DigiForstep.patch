+namespace OnlineProto
+{
+	// Wire format (TCP): [u32 length LE][u8 type][payload], length = 1 + payload size.
+	enum MsgType : quint8
+	{
+		MSG_WELCOME = 1, // host -> guest: u8 guestSlot (255 = session full), u8 padIndex
+		MSG_FRAME = 2,   // host -> guest: JPEG image
+		MSG_INPUT = 3,   // guest -> host: u32 buttonMask LE (bit n = PS2 BUTTON n), u8 LX, LY, RX, RY
+		MSG_AUDIO = 4,   // host -> guest: u32 sampleRate LE, then interleaved stereo int16 samples
+	};
+
+	constexpr int MAX_GUESTS = 3; // host + 3 guests = 4 players
+	constexpr quint16 DEFAULT_PORT = 7777;
+
+	QByteArray Pack(MsgType, const QByteArray& payload);
+	// Calls handler(type, payload) for each complete message and removes them from buffer.
+	// Returns false if the stream is corrupt.
+	bool Unpack(QByteArray& buffer, const std::function<void(quint8, const QByteArray&)>& handler);
+}
