+using namespace OnlineProto;
+
+QByteArray OnlineProto::Pack(MsgType type, const QByteArray& payload)
+{
+	char header[4];
+	qToLittleEndian<quint32>(static_cast<quint32>(payload.size() + 1), header);
+	QByteArray result;
+	result.reserve(5 + payload.size());
+	result.append(header, 4);
+	result.append(static_cast<char>(type));
+	result.append(payload);
+	return result;
+}
+
+bool OnlineProto::Unpack(QByteArray& buffer, const std::function<void(quint8, const QByteArray&)>& handler)
+{
+	int offset = 0;
+	bool ok = true;
+	while(buffer.size() - offset >= 4)
+	{
+		quint32 length = qFromLittleEndian<quint32>(buffer.constData() + offset);
+		if(length == 0 || length > 4 * 1024 * 1024)
+		{
+			ok = false;
+			break;
+		}
+		if(static_cast<quint32>(buffer.size() - offset - 4) < length) break;
+		quint8 type = static_cast<quint8>(buffer[offset + 4]);
+		handler(type, buffer.mid(offset + 5, length - 1));
+		offset += 4 + length;
+	}
+	if(ok)
+		buffer.remove(0, offset);
+	else
+		buffer.clear();
+	return ok;
+}
+
+//////////////////////////////////////////////////////////////////////////////////////////
+// Host
+//////////////////////////////////////////////////////////////////////////////////////////
+
+COnlineHost::COnlineHost(QObject* parent)
+    : QObject(parent)
+{
+	connect(&m_server, &QTcpServer::newConnection, this, &COnlineHost::OnNewConnection);
+	connect(&m_udp, &QUdpSocket::readyRead, this, &COnlineHost::OnUdpData);
+}
+
+COnlineHost::~COnlineHost()
+{
+	Stop();
+}
+
+void COnlineHost::SetPadHandlerGetter(PadHandlerGetter getter)
+{
+	m_padHandlerGetter = std::move(getter);
+}
+
+bool COnlineHost::IsRunning() const
+{
+	return m_server.isListening();
+}
+
+QString COnlineHost::ErrorString() const
+{
+	return m_server.errorString();
+}
+
+bool COnlineHost::Start(quint16 port)
+{
+	if(IsRunning()) return true;
+	if(!m_server.listen(QHostAddress::AnyIPv4, port)) return false;
+	if(!m_udp.bind(QHostAddress::AnyIPv4, port))
+	{
+		m_server.close();
+		return false;
+	}
+
+	m_encoderQuit = false;
+	m_encoderThread = std::thread([this] { EncoderLoop(); });
+	UpdateCapture();
+	return true;
+}
+
+void COnlineHost::Stop()
+{
+	m_server.close();
+	m_udp.close();
+	for(auto& guest : m_guests)
+	{
+		if(guest.socket)
+		{
+			auto* socket = guest.socket;
+			guest = Guest();
+			socket->disconnect(this);
+			socket->abort();
+			socket->deleteLater();
+		}
+	}
+	CFrameShare::GetInstance().Disable();
+	CAudioShare::GetInstance().Disable();
+	if(m_encoderThread.joinable())
+	{
+		{
+			std::lock_guard<std::mutex> lock(m_encoderMutex);
+			m_encoderQuit = true;
+		}
+		m_encoderCv.notify_all();
+		m_encoderThread.join();
+	}
+	PushState();
+	emit guestsChanged();
+}
+
+COnlineHost::GuestInfo COnlineHost::GetGuest(int slot) const
+{
+	GuestInfo info;
+	if(slot < 0 || slot >= MAX_GUESTS || !m_guests[slot].socket) return info;
+	info.connected = true;
+	info.address = m_guests[slot].socket->peerAddress().toString();
+	info.pad = m_guests[slot].pad;
+	return info;
+}
+
+void COnlineHost::SetGuestPad(int slot, int pad)
+{
+	if(slot < 0 || slot >= MAX_GUESTS || pad < 0 || pad >= CInputBindingManager::MAX_PADS) return;
+	m_guests[slot].pad = pad;
+	SendWelcome(slot);
+	PushState();
+}
+
+int COnlineHost::GuestCount() const
+{
+	int count = 0;
+	for(const auto& guest : m_guests)
+		if(guest.socket) count++;
+	return count;
+}
+
+void COnlineHost::OnNewConnection()
+{
+	while(m_server.hasPendingConnections())
+	{
+		auto* socket = m_server.nextPendingConnection();
+		int slot = -1;
+		for(int i = 0; i < MAX_GUESTS; i++)
+		{
+			if(!m_guests[i].socket)
+			{
+				slot = i;
+				break;
+			}
+		}
+		if(slot < 0)
+		{
+			QByteArray full;
+			full.append(static_cast<char>(0xFF));
+			full.append(static_cast<char>(0));
+			socket->write(Pack(MSG_WELCOME, full));
+			socket->flush();
+			socket->disconnectFromHost();
+			connect(socket, &QTcpSocket::disconnected, socket, &QObject::deleteLater);
+			continue;
+		}
+		socket->setSocketOption(QAbstractSocket::LowDelayOption, 1);
+		socket->setSocketOption(QAbstractSocket::SendBufferSizeSocketOption, 64 * 1024); // small kernel queue = low latency
+		m_guests[slot] = Guest();
+		m_guests[slot].socket = socket;
+		connect(socket, &QTcpSocket::readyRead, this, [this, slot, socket] { OnGuestData(slot, socket); });
+		connect(socket, &QTcpSocket::disconnected, this, [this, slot, socket] { OnGuestDisconnected(slot, socket); });
+		SendWelcome(slot);
+		UpdateCapture();
+		emit guestsChanged();
+	}
+}
+
+void COnlineHost::SendWelcome(int slot)
+{
+	auto* socket = m_guests[slot].socket;
+	if(!socket) return;
+	QByteArray payload;
+	payload.append(static_cast<char>(slot));
+	payload.append(static_cast<char>(m_guests[slot].pad));
+	socket->write(Pack(MSG_WELCOME, payload));
+}
+
+void COnlineHost::OnGuestData(int slot, QTcpSocket* socket)
+{
+	auto& guest = m_guests[slot];
+	if(guest.socket != socket) return;
+	guest.rx.append(socket->readAll());
+	bool ok = Unpack(guest.rx, [&](quint8 type, const QByteArray& payload) {
+		if(type == MSG_INPUT && payload.size() == 8)
+		{
+			guest.buttons = qFromLittleEndian<quint32>(payload.constData());
+			memcpy(guest.axes, payload.constData() + 4, 4);
+		}
+	});
+	if(!ok)
+	{
+		socket->abort();
+		return;
+	}
+	PushState();
+}
+
+void COnlineHost::OnGuestDisconnected(int slot, QTcpSocket* socket)
+{
+	if(m_guests[slot].socket != socket) return;
+	m_guests[slot] = Guest();
+	socket->deleteLater();
+	PushState();
+	UpdateCapture();
+	emit guestsChanged();
+}
+
+// Merge every guest that controls a given pad into one remote state for that pad.
+void COnlineHost::PushState()
+{
+	auto* padHandler = m_padHandlerGetter ? m_padHandlerGetter() : nullptr;
+	if(!padHandler) return;
+	for(int pad = 0; pad < CInputBindingManager::MAX_PADS; pad++)
+	{
+		bool active = false;
+		quint32 buttons = 0;
+		uint8 axes[4] = {0x80, 0x80, 0x80, 0x80};
+		for(const auto& guest : m_guests)
+		{
+			if(!guest.socket || guest.pad != pad) continue;
+			active = true;
+			buttons |= guest.buttons;
+			for(int i = 0; i < 4; i++)
+			{
+				if(std::abs(int(guest.axes[i]) - 0x80) > std::abs(int(axes[i]) - 0x80))
+					axes[i] = guest.axes[i];
+			}
+		}
+		padHandler->SetRemoteState(pad, active, buttons, axes);
+	}
+}
+
+void COnlineHost::UpdateCapture()
+{
+	if(IsRunning() && GuestCount() > 0)
+	{
+		CFrameShare::GetInstance().Enable([this](QImage image) {
+			{
+				std::lock_guard<std::mutex> lock(m_encoderMutex);
+				m_pendingImage = std::move(image); // keep only the newest frame
+			}
+			m_encoderCv.notify_one();
+		});
+	}
+	else
+	{
+		CFrameShare::GetInstance().Disable();
+	}
+
+	if(IsRunning() && GuestCount() > 0)
+	{
+		CAudioShare::GetInstance().Enable([this](const int16* samples, unsigned int count, unsigned int rate) {
+			QByteArray payload(4 + count * sizeof(int16), 0);
+			qToLittleEndian<quint32>(rate, payload.data());
+			memcpy(payload.data() + 4, samples, count * sizeof(int16));
+			QMetaObject::invokeMethod(this, [this, payload] { BroadcastAudio(payload); }, Qt::QueuedConnection);
+		});
+	}
+	else
+	{
+		CAudioShare::GetInstance().Disable();
+	}
+}
+
+void COnlineHost::BroadcastAudio(const QByteArray& payload)
+{
+	auto message = Pack(MSG_AUDIO, payload);
+	for(auto& guest : m_guests)
+	{
+		if(guest.socket && guest.socket->bytesToWrite() < (2 << 20))
+			guest.socket->write(message);
+	}
+}
+
+void COnlineHost::EncoderLoop()
+{
+	while(true)
+	{
+		QImage image;
+		{
+			std::unique_lock<std::mutex> lock(m_encoderMutex);
+			m_encoderCv.wait(lock, [this] { return m_encoderQuit || !m_pendingImage.isNull(); });
+			if(m_encoderQuit) return;
+			image = std::move(m_pendingImage);
+			m_pendingImage = QImage();
+		}
+		image = image.mirrored(false, true); // GL read-back is bottom-up
+		int maxWidth = m_maxWidth;
+		if(image.width() > maxWidth) image = image.scaledToWidth(maxWidth, Qt::FastTransformation);
+		QByteArray jpeg;
+		QBuffer buffer(&jpeg);
+		buffer.open(QIODevice::WriteOnly);
+		image.save(&buffer, "JPEG", m_jpegQuality);
+		QMetaObject::invokeMethod(this, [this, jpeg] { BroadcastFrame(jpeg); }, Qt::QueuedConnection);
+	}
+}
+
+void COnlineHost::SetQualityPreset(int preset)
+{
+	static const int widths[] = {448, 512, 640};
+	static const int qualities[] = {45, 55, 70};
+	static const int intervals[] = {33, 33, 40};
+	preset = std::max(0, std::min(preset, 2));
+	m_maxWidth = widths[preset];
+	m_jpegQuality = qualities[preset];
+	CFrameShare::GetInstance().SetIntervalMs(intervals[preset]);
+}
+
+// Guest input arrives over UDP: [u8 slot][u16 seq][u32 buttons][u8 LX, LY, RX, RY]
+void COnlineHost::OnUdpData()
+{
+	while(m_udp.hasPendingDatagrams())
+	{
+		auto datagram = m_udp.receiveDatagram();
+		const QByteArray data = datagram.data();
+		if(data.size() != 11) continue;
+		int slot = static_cast<quint8>(data[0]);
+		if(slot >= MAX_GUESTS) continue;
+		auto& guest = m_guests[slot];
+		if(!guest.socket) continue;
+		bool senderOk = false, peerOk = false;
+		quint32 sender = datagram.senderAddress().toIPv4Address(&senderOk);
+		quint32 peer = guest.socket->peerAddress().toIPv4Address(&peerOk);
+		if(!senderOk || !peerOk || sender != peer) continue; // only accept from the connected guest
+		quint16 seq = qFromLittleEndian<quint16>(data.constData() + 1);
+		if(guest.hasSeq && static_cast<qint16>(seq - guest.lastSeq) <= 0) continue; // old or duplicate
+		guest.hasSeq = true;
+		guest.lastSeq = seq;
+		guest.buttons = qFromLittleEndian<quint32>(data.constData() + 3);
+		memcpy(guest.axes, data.constData() + 7, 4);
+		PushState();
+	}
+}
+
+void COnlineHost::BroadcastFrame(const QByteArray& jpeg)
+{
+	if(jpeg.isEmpty()) return;
+	auto message = Pack(MSG_FRAME, jpeg);
+	for(auto& guest : m_guests)
+	{
+		//Drop the frame for slow guests instead of building up latency
+		if(guest.socket && guest.socket->bytesToWrite() < 48 * 1024) // previous frame still in flight: skip this one
+			guest.socket->write(message);
+	}
+}
+
+//////////////////////////////////////////////////////////////////////////////////////////
+// Host dialog
+//////////////////////////////////////////////////////////////////////////////////////////
+
+COnlineHostDialog::COnlineHostDialog(COnlineHost* host, QWidget* parent)
+    : QDialog(parent)
+    , m_host(host)
+{
+	setWindowTitle(tr("DigiForstep - Host Session"));
+	auto* layout = new QVBoxLayout(this);
+
+	auto* portRow = new QHBoxLayout();
+	portRow->addWidget(new QLabel(tr("Port:"), this));
+	m_port = new QSpinBox(this);
+	m_port->setRange(1024, 65535);
+	m_port->setValue(DEFAULT_PORT);
+	portRow->addWidget(m_port);
+	m_toggle = new QPushButton(tr("Start hosting"), this);
+	portRow->addWidget(m_toggle);
+	layout->addLayout(portRow);
+
+	auto* qualityRow = new QHBoxLayout();
+	qualityRow->addWidget(new QLabel(tr("Stream quality:"), this));
+	m_quality = new QComboBox(this);
+	m_quality->addItems({tr("Low latency (recommended)"), tr("Balanced"), tr("High quality")});
+	qualityRow->addWidget(m_quality);
+	layout->addLayout(qualityRow);
+	connect(m_quality, QOverload<int>::of(&QComboBox::currentIndexChanged), this, [this](int index) {
+		m_host->SetQualityPreset(index);
+	});
+	m_host->SetQualityPreset(0);
+
+	m_status = new QLabel(this);
+	layout->addWidget(m_status);
+	m_addresses = new QLabel(this);
+	m_addresses->setTextInteractionFlags(Qt::TextSelectableByMouse);
+	m_addresses->setWordWrap(true);
+	layout->addWidget(m_addresses);
+
+	for(int i = 0; i < MAX_GUESTS; i++)
+	{
+		auto* row = new QHBoxLayout();
+		m_guestLabels[i] = new QLabel(this);
+		m_guestPads[i] = new QComboBox(this);
+		for(int pad = 1; pad <= CInputBindingManager::MAX_PADS; pad++)
+			m_guestPads[i]->addItem(tr("Controls pad %1").arg(pad));
+		row->addWidget(m_guestLabels[i], 1);
+		row->addWidget(m_guestPads[i]);
+		layout->addLayout(row);
+		connect(m_guestPads[i], QOverload<int>::of(&QComboBox::currentIndexChanged), this, [this, i](int index) {
+			m_host->SetGuestPad(i, index);
+		});
+	}
+
+	connect(m_toggle, &QPushButton::clicked, this, &COnlineHostDialog::ToggleServer);
+	connect(m_host, &COnlineHost::guestsChanged, this, &COnlineHostDialog::Refresh);
+	Refresh();
+}
+
+void COnlineHostDialog::ToggleServer()
+{
+	if(m_host->IsRunning())
+		m_host->Stop();
+	else if(!m_host->Start(static_cast<quint16>(m_port->value())))
+		m_status->setText(tr("Could not start: %1").arg(m_host->ErrorString()));
+	Refresh();
+}
+
+void COnlineHostDialog::Refresh()
+{
+	bool running = m_host->IsRunning();
+	m_toggle->setText(running ? tr("Stop hosting") : tr("Start hosting"));
+	m_port->setEnabled(!running);
+	if(running)
+	{
+		m_status->setText(tr("Hosting. Guests see your game screen and share your controller."));
+		QStringList addresses;
+		for(const auto& address : QNetworkInterface::allAddresses())
+		{
+			if(address.protocol() == QAbstractSocket::IPv4Protocol && !address.isLoopback())
+				addresses << address.toString();
+		}
+		m_addresses->setText(tr("Give your friends one of these addresses (the Radmin VPN one): %1").arg(addresses.join(", ")));
+	}
+	else if(!m_status->text().startsWith(tr("Could not")))
+	{
+		m_status->setText(tr("Not hosting."));
+		m_addresses->clear();
+	}
+	for(int i = 0; i < MAX_GUESTS; i++)
+	{
+		auto info = m_host->GetGuest(i);
+		m_guestLabels[i]->setText(info.connected ? tr("Guest %1: %2").arg(i + 1).arg(info.address) : tr("Guest %1: (empty)").arg(i + 1));
+		m_guestPads[i]->setEnabled(info.connected);
+		QSignalBlocker blocker(m_guestPads[i]);
+		m_guestPads[i]->setCurrentIndex(info.pad);
+	}
+}
